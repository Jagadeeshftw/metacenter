(define-read-only (bond-sp (i uint))
  (contract-call? 'SP000000000000000000002Q6VF78.pox-5 get-protocol-bond i))
(define-read-only (bond-st (i uint))
  (contract-call? 'ST000000000000000000002AMW42H.pox-5 get-protocol-bond i))
(define-read-only (total-sbtc)
  (contract-call? 'SP000000000000000000002Q6VF78.pox-5 get-total-sbtc-staked))
(define-read-only (cycle)
  (contract-call? 'SP000000000000000000002Q6VF78.pox-5 current-pox-reward-cycle))
(define-read-only (membership (who principal))
  (contract-call? 'SP000000000000000000002Q6VF78.pox-5 get-bond-membership who))
(define-read-only (staker (who principal))
  (contract-call? 'SP000000000000000000002Q6VF78.pox-5 get-staker-info who))
(define-read-only (pox-info)
  (contract-call? 'SP000000000000000000002Q6VF78.pox-5 get-pox-info))
